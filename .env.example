NODE_ENV=development
PORT=3000
DB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/bildyapp?retryWrites=true&w=majority
JWT_SECRET=<tu_secret_de_32_caracteres_minimo>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# Slack Webhook (para logger service)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<tu_email@gmail.com>
SMTP_PASS=<tu_app_password>
EMAIL_FROM=noreply@bildyapp.com
